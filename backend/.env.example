# Local Supabase CLI uses its own defaults; this file is for variables the human
# may need when linking to a hosted project later (Chunk 13).
SUPABASE_PROJECT_ID=fgtkbmxjplgabhtpumzj
SUPABASE_DB_PASSWORD=

# --- Edge Function secrets (Chunk 11: anthropic-proxy) ---------------------------------------
# Required to run `supabase functions serve anthropic-proxy --env-file .env` locally, and to be
# set as Supabase project secrets before the hosted deploy (Chunk 13). The Edge Function reads
# all four from its environment.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: from `supabase status` locally
#   (the API URL + the anon + service_role keys), or the hosted project dashboard → API settings.
#   The service role key is used by the function ONLY for ai_request_log inserts + rate-limit
#   reads. It must NEVER ship in the frontend bundle.
# ANTHROPIC_API_KEY: from the Anthropic console (console.anthropic.com -> API keys).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
